# Files git must never track in this package. The fleet's shared list, so every repo ignores the same things; entries for tools this
# package does not use cost nothing and stop a stray file being committed.

# Dependencies: installed from the lockfile by `npm ci`.
node_modules/

# Build output: dist/ is emitted by `npm run build` and published, never committed.
dist/
build/

# Type-check cache
*.tsbuildinfo

# Test output
coverage/
.vitest-cache/

# Environment: local settings and secrets stay out of git; only an example file may be committed.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Playwright output: reports and traces from a local or CI run (the helper tests drive a real Chromium).
test-results/
playwright-report/
blob-report/
